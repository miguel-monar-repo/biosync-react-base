# Copia este archivo como .env y rellena los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Configuración).
# El archivo .env NO se sube a Git. Si lo dejas vacío, la app funciona sin sincronizar.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dirección de la API (proyecto "api" en Vercel), sin "/" al final.
# En local déjala vacía: el formulario usa el proxy de Vite hacia http://localhost:4000.
# En Vercel se configura en el panel: https://biosync-api.vercel.app (ejemplo)
VITE_API_URL=
